<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- Auto Scheduler: SMS/CALL channels only so far (see AutoTaskAlarmReceiver). -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Forward Call: detect + look up a missed call (ForwardCallReceiver), forward it by SMS. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Auto Reply's "Also reply to SMS" (SmsAutoReplyReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Journal attachments: in-app audio recording, current-location tagging,
         and the recent-photos suggestions tray. Camera/gallery photo & video
         capture use the system apps' own pickers and need no permission here. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Auto Reply's "only while Bluetooth is on" condition; isEnabled() needs this pre-31, is unrestricted after. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <!-- Watch Sync: BLE scan/connect to nearby watches (Noise ColorFit etc.) to push time.
         BLUETOOTH_SCAN/CONNECT are no-ops pre-31, where plain BLUETOOTH(_ADMIN) above covers it. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Reminders"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EditReminderActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AccountActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".JournalActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".JournalEditActivity"
            android:exported="false"
            android:parentActivityName=".JournalActivity" />

        <activity
            android:name=".JournalSuggestionsActivity"
            android:exported="false"
            android:parentActivityName=".JournalEditActivity" />

        <activity
            android:name=".JournalCalendarActivity"
            android:exported="false"
            android:parentActivityName=".JournalActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/journal_file_paths" />
        </provider>

        <activity
            android:name=".AlarmRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:taskAffinity=".AlarmRing" />

        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!--
          Claude limits. The shared components live in usage-core; this app opts
          into the ones it uses. The reset alarm classes are separate from this
          app's own reminder alarm stack, so the two never collide.
        -->
        <activity
            android:name=".WatchSyncActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ClaudeAlertsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Auto Scheduler: schedules a one-off SMS/call/reminder for a future time. -->
        <activity
            android:name=".AutoSchedulerActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".EditAutoTaskActivity"
            android:exported="false"
            android:parentActivityName=".AutoSchedulerActivity" />

        <activity
            android:name=".RecipientListActivity"
            android:exported="false"
            android:parentActivityName=".AutoSchedulerActivity" />

        <activity
            android:name=".EditRecipientListActivity"
            android:exported="false"
            android:parentActivityName=".RecipientListActivity" />

        <activity
            android:name=".TemplateActivity"
            android:exported="false"
            android:parentActivityName=".AutoSchedulerActivity" />

        <activity
            android:name=".EditTemplateActivity"
            android:exported="false"
            android:parentActivityName=".TemplateActivity" />

        <activity
            android:name=".AutoReplySettingsActivity"
            android:exported="false"
            android:parentActivityName=".AutoSchedulerActivity" />

        <activity
            android:name=".AutoReplyRuleListActivity"
            android:exported="false"
            android:parentActivityName=".AutoReplySettingsActivity" />

        <activity
            android:name=".EditAutoReplyRuleActivity"
            android:exported="false"
            android:parentActivityName=".AutoReplyRuleListActivity" />

        <activity
            android:name=".AutoForwardSettingsActivity"
            android:exported="false"
            android:parentActivityName=".AutoSchedulerActivity" />

        <activity
            android:name=".ForwardCallSettingsActivity"
            android:exported="false"
            android:parentActivityName=".AutoSchedulerActivity" />

        <activity
            android:name=".CallReplySettingsActivity"
            android:exported="false"
            android:parentActivityName=".AutoSchedulerActivity" />

        <activity
            android:name=".AutoSchedulerSettingsActivity"
            android:exported="false"
            android:parentActivityName=".AutoSchedulerActivity" />

        <activity
            android:name=".FakeCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=".FakeCall" />

        <service
            android:name=".AutoTextNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".AutoTaskAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".PendingActionWatchdogReceiver"
            android:exported="false" />

        <receiver
            android:name=".AutoTaskLockRetryReceiver"
            android:exported="false" />

        <!-- Missed-call detection for Forward Call — a protected system broadcast,
             so exported="false" still reaches it (same as BootReceiver above). -->
        <receiver
            android:name=".ForwardCallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Call Auto Reply: same PHONE_STATE broadcast as ForwardCallReceiver,
             so exported="false" still reaches it (same as BootReceiver above). -->
        <receiver
            android:name=".CallReplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- SMS Auto Reply. android.provider.Telephony.SMS_RECEIVED requires
             exported="true" + BROADCAST_SMS so the telephony process can deliver
             it, even though this app isn't the default SMS app. -->
        <receiver
            android:name=".SmsAutoReplyReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AutoTextAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <activity
            android:name="online.productwithrohan.usagecore.LoginActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name="online.productwithrohan.usagecore.AlarmRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:taskAffinity=".AlarmRing" />

        <service
            android:name="online.productwithrohan.usagecore.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name="online.productwithrohan.usagecore.ResetAlarmReceiver"
            android:exported="false" />

        <!--
          The same Claude limits widget the standalone app offers. Android's
          widget picker groups by app, so having both installed shows one entry
          under each rather than two indistinguishable ones.
        -->
        <receiver
            android:name="online.productwithrohan.usagecore.UsageWidgetProvider"
            android:exported="true"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Sent by usage-core's RefreshWorker when a new snapshot lands. -->
                <action android:name="online.productwithrohan.reminders.USAGE_UPDATED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_info" />
        </receiver>
    </application>
</manifest>

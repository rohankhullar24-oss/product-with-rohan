index 00000000..50ac2261
--- /dev/null
+++ b/frontend/src/lib/daily-suggest.js
@@ -0,0 +1,140 @@
+// A suggested session for every day of the week (added for the Reminders app's Open Gym
+// section; not part of upstream openGym). A day with nothing planned no longer reads as a bare
+// "Rest day": Home offers a session picked for that weekday instead, and one tap turns it into
+// an ordinary routine pinned to the day.
+//
+// The week is a fixed split, so the same weekday always trains the same thing. Each slot of a
+// session lists a few lifts that do the same job; which one is offered moves on by one every
+// calendar week (and by one more per Shuffle), so Monday is always Push but not always the same
+// six exercises. A lift the active equipment profile rules out gives way to the slot's next
+// option, then to the closest match the catalogue has (lib/starter.js substituteFor).
+import { EXIDX } from './exercises.js'
+import { activeProfile, exAvailable, profileEquipment } from './equipment.js'
+import { substituteFor } from './starter.js'
+import { uid } from './format.js'
+
+// weekday (0 = Sunday) → { key, name, focus, emoji, slots: [[options…], sets, reps] }.
+// Names stay canonical English, like the starter plans: they become ordinary user routines.
+export const SPLIT = {
+  1: { key: 'push', name: 'Suggested Push', focus: 'Chest, shoulders and triceps', emoji: 'barbell', slots: [
+    [['0025', '0289', '0662'], 4, 8],      // bench press: barbell, dumbbell, push-up
+    [['0314', '0047', '0251'], 3, 10],     // incline press or dip
+    [['0426', '0405', '0091'], 3, 10],     // overhead press
+    [['0334', '0178'], 3, 12],             // lateral raise
+    [['0241', '0351', '0814'], 3, 12],     // triceps
+    [['0308', '0662'], 3, 12]              // fly or push-up finisher
+  ] },
+  2: { key: 'pull', name: 'Suggested Pull', focus: 'Back and biceps', emoji: 'pullup', slots: [
+    [['2330', '0652', '1326'], 4, 10],     // vertical pull
+    [['0027', '0293', '0499'], 4, 8],      // row
+    [['1323', '0293', '0499'], 3, 10],     // second row
+    [['0378', '2487'], 3, 12],             // rear delts
+    [['0031', '0294', '0868'], 3, 10],     // curl
+    [['0313', '0285'], 3, 12]              // hammer or alternating curl
+  ] },
+  3: { key: 'legs', name: 'Suggested Legs', focus: 'Quads, hamstrings and calves', emoji: 'legs', slots: [
+    [['0043', '1760', '3948'], 4, 8],      // squat
+    [['0085', '1459'], 3, 10],             // Romanian deadlift
+    [['0739', '2290', '0336'], 3, 12],     // leg press, split squat or lunge
+    [['0586', '2072'], 3, 12],             // leg curl or hip thrust
+    [['0585', '1460'], 3, 12],             // leg extension or walking lunge
+    [['0605', '0594'], 4, 15]              // calves
+  ] },
+  4: { key: 'core', name: 'Suggested Core and Cardio', focus: 'Abs, obliques and conditioning', emoji: 'abs', slots: [
+    [['0472', '0274', '6211'], 3, 12],     // leg raise or crunch
+    [['0687', '3449'], 3, 20],             // Russian twist
+    [['0276', '6211'], 3, 12],             // dead bug or bicycle crunch
+    [['0630', '3094'], 3, 30],             // mountain climber or jumping jack
+    [['1160', '3094'], 3, 10]              // burpee
+  ] },
+  5: { key: 'upper', name: 'Suggested Upper Body', focus: 'Chest, back, shoulders and arms', emoji: 'figureStrength', slots: [
+    [['0289', '0025', '0662'], 3, 10],     // press
+    [['0293', '0027', '0499'], 3, 10],     // row
+    [['0405', '0426'], 3, 10],             // shoulder press
+    [['0652', '2330', '1326'], 3, 8],      // pull-up or pulldown
+    [['0334', '0178'], 2, 15],             // lateral raise
+    [['0294', '0031'], 2, 12],             // curl
+    [['0351', '0241', '0814'], 2, 12]      // triceps
+  ] },
+  6: { key: 'lower', name: 'Suggested Lower Body', focus: 'Glutes, hamstrings and quads', emoji: 'legs', slots: [
+    [['0032', '1459', '0085'], 4, 6],      // deadlift
+    [['2290', '0336', '1460'], 3, 10],     // single-leg work
+    [['1409', '2072'], 3, 12],             // glute bridge or hip thrust
+    [['1760', '0739', '3948'], 3, 12],     // goblet squat or leg press
+    [['0586', '0431'], 3, 12],             // leg curl or step-up
+    [['0605', '0594'], 3, 15]              // calves
+  ] },
+  0: { key: 'recovery', name: 'Suggested Recovery', focus: 'Easy movement, nothing heavy', emoji: 'stretch', slots: [
+    [['4580'], 2, 10],                     // cat cow
+    [['1604'], 2, 6],                      // world's greatest stretch
+    [['2072'], 2, 15],                     // hip thrust, body weight
+    [['0276'], 2, 10],                     // dead bug
+    [['3948'], 2, 15]                      // air squat
+  ] }
+}
+
+const weekdayOf = iso => new Date(iso + 'T12:00:00').getDay()
+// Whole weeks since a fixed Monday, so the offered option changes when the week does.
+const weekIndex = iso => Math.floor((Date.parse(iso + 'T12:00:00Z') - Date.UTC(2024, 0, 1)) / 6048e5)
+
+/**
+ * The session suggested for `iso` under the user's equipment: `{ key, name, focus, emoji, ex }`
+ * with `ex` shaped like a routine's (`{ id, sets, reps, weight }`), or null when the equipment
+ * leaves nothing to do. `shift` moves every slot on by that many options (Shuffle).
+ */
+export function suggestionFor(S, iso, shift = 0) {
+  const day = SPLIT[weekdayOf(iso)]
+  if (!day) return null
+  const profile = activeProfile(S)
+  const equipment = profile ? profileEquipment(profile) : null
+  const turn = weekIndex(iso) + shift
+  const taken = new Set()
+  const ex = []
+  for (const [options, sets, reps] of day.slots) {
+    const n = options.length
+    let pick = null
+    for (let i = 0; i < n && !pick; i++) {
+      const c = EXIDX[options[(((turn + i) % n) + n) % n]]
+      if (c && !taken.has(c.id) && exAvailable(S, c)) pick = c
+    }
+    if (!pick && equipment && EXIDX[options[0]]) pick = substituteFor(EXIDX[options[0]], equipment, taken)
+    if (!pick) continue
+    taken.add(pick.id)
+    ex.push({ id: pick.id, sets, reps, weight: 0 })
+  }
+  return ex.length ? { key: day.key, name: day.name, focus: day.focus, emoji: day.emoji, ex } : null
+}
+
+const sameLifts = (a, b) => a.ex.length === b.ex.length && a.ex.every((e, i) => e.id === b.ex[i].id)
+
+// Inside an update(): the routine for a suggestion, reusing the one an earlier tap made (same
+// name, same lifts) so a week of suggestions does not pile up copies. Returns its id.
+export function adoptSuggestion(st, sug) {
+  const have = st.routines.find(r => r.name === sug.name && sameLifts(r, sug))
+  if (have) return have.id
+  const routine = { id: uid(), name: sug.name, emoji: sug.emoji, ex: sug.ex.map(e => ({ ...e })) }
+  st.routines.push(routine)
+  return routine.id
+}
+
+/**
+ * Inside an update(): puts this week's suggestion on every weekday that has no routine yet.
+ * Sunday stays a rest day in the plan (its recovery session is still offered on the day).
+ * `shift` is the Shuffle the card is showing, so the week matches what was on screen.
+ * Returns how many weekdays it filled.
+ */
+export function fillWeekWithSuggestions(st, todayIso, shift = 0) {
+  const base = new Date(todayIso + 'T12:00:00')
+  let filled = 0
+  for (let i = 0; i < 7; i++) {
+    const d = new Date(base); d.setDate(base.getDate() + i)
+    const day = d.getDay()
+    if (day === 0 || [].concat(st.week[day] || []).length) continue
+    const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
+    const sug = suggestionFor(st, iso, shift)
+    if (!sug) continue
+    st.week[day] = [adoptSuggestion(st, sug)]
+    filled++
+  }
+  return filled
+}

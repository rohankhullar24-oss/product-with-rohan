<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup format (backup_rules.xml is the pre-31 mirror of this: keep both
  in sync). Covers every locally-stored Auto Scheduler data set (see ARCHITECTURE.md
  and BackupManager.kt for the same list), for both cloud backup (Google account) and
  device-to-device transfer, so Android's own restore round-trips it without the user
  needing BackupManager's manual export first.
  supabase_session is deliberately excluded from both: an auth token shouldn't
  silently restore onto a different device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="reminders.json" />
        <include domain="file" path="auto_tasks.json" />
        <include domain="file" path="recipient_lists.json" />
        <include domain="file" path="templates.json" />
        <include domain="file" path="auto_reply_rules.json" />

        <include domain="sharedpref" path="auto_reply_settings.xml" />
        <include domain="sharedpref" path="auto_forward_settings.xml" />
        <include domain="sharedpref" path="forward_call_settings.xml" />
        <include domain="sharedpref" path="call_reply_settings.xml" />
        <include domain="sharedpref" path="auto_scheduler_settings.xml" />

        <exclude domain="sharedpref" path="supabase_session.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="reminders.json" />
        <include domain="file" path="auto_tasks.json" />
        <include domain="file" path="recipient_lists.json" />
        <include domain="file" path="templates.json" />
        <include domain="file" path="auto_reply_rules.json" />

        <include domain="sharedpref" path="auto_reply_settings.xml" />
        <include domain="sharedpref" path="auto_forward_settings.xml" />
        <include domain="sharedpref" path="forward_call_settings.xml" />
        <include domain="sharedpref" path="call_reply_settings.xml" />
        <include domain="sharedpref" path="auto_scheduler_settings.xml" />

        <exclude domain="sharedpref" path="supabase_session.xml" />
    </device-transfer>
</data-extraction-rules>

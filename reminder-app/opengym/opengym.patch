+// Home's "Suggested for today" card (added for the Reminders app's Open Gym section; not part
+// of upstream openGym). Shown on a day with nothing planned and nothing logged: the session
+// lib/daily-suggest.js picks for the weekday, one tap from being today's workout.
+import { useState } from 'react'
+import { useStore } from '../store/useStore.js'
+import { useUI } from '../store/useUI.js'
+import { EXIDX } from '../lib/exercises.js'
+import { todayISO } from '../lib/format.js'
+import { t, exerciseNameFor } from '../lib/i18n.js'
+import { suggestionFor, adoptSuggestion, fillWeekWithSuggestions } from '../lib/daily-suggest.js'
+import { startFlow } from '../sheets.jsx'
+import CardHead from './CardHead.jsx'
+import { Button } from './ui.jsx'
+
+export default function DailySuggestion({ S }) {
+  const [shift, setShift] = useState(0)
+  const iso = todayISO()
+  const sug = suggestionFor(S, iso, shift)
+  if (!sug) return null
+  const update = (...a) => useStore.getState().update(...a)
+
+  const start = () => {
+    let id = null
+    update(st => { id = adoptSuggestion(st, sug); st.dayPlan[iso] = id })
+    if (id) startFlow([id])
+  }
+  const fillWeek = () => {
+    let n = 0
+    update(st => { n = fillWeekWithSuggestions(st, iso, shift) })
+    useUI.getState().toast(n ? t('Your week is planned. Change any day in Plan.') : t('Every training day already has a routine.'))
+  }
+
+  return <div className="card daily-suggestion">
+    <CardHead icon="sparkles" tint="var(--acc)" eyebrow={t('Suggested for today')} title={sug.name.replace(/^Suggested /, '')} sub={t(sug.focus)}
+      action={<Button size="sm" variant="ghost" icon="shuffle" aria-label={t('Shuffle')} onClick={() => setShift(n => n + 1)}>{t('Shuffle')}</Button>} />
+    <div style={{ margin: '4px 0 12px' }}>
+      {sug.ex.map(e => <div key={e.id} className="row between small" style={{ padding: '5px 0', gap: 12 }}>
+        <span style={{ minWidth: 0, textTransform: 'capitalize' }}>{EXIDX[e.id] ? exerciseNameFor(EXIDX[e.id]) : e.id}</span>
+        <span className="muted" style={{ flexShrink: 0, fontVariantNumeric: 'tabular-nums' }}>{e.sets} × {e.reps}</span>
+      </div>)}
+    </div>
+    <Button variant="primary" icon="play" onClick={start}>{t('Start this workout')}</Button>
+    <div style={{ height: 8 }} />
+    <Button icon="calendar" onClick={fillWeek}>{t('Plan my whole week like this')}</Button>
+  </div>
+}
